---
import { getDiwanBooks } from "../generators/diwan-books"
import { getTimeline } from "../generators/timeline"

const timeline = await getTimeline()
const books = await getDiwanBooks(timeline)

const totalBooks = books.length
const totalChapters = books.reduce((sum, b) => sum + b.chapters.length, 0)
const totalHadiths = books.reduce((sum, b) => sum + b.hadith_count, 0)
---

<html lang='ar' dir='rtl'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>فهرس دروس كرسي الإمام مالك</title>
    <meta
      name='description'
      content='فهرس الكتب والأبواب في سلسلة دروس كرسي الإمام مالك'
    />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Amiri:wght@700&display=swap'
      rel='stylesheet'
    />
    <style>
      :root {
        --bg: #faf7f2;
        --bg-card: #ffffff;
        --ink: #1c1a17;
        --ink-soft: #5b554c;
        --accent: #8a6d3b;
        --accent-soft: #c9a961;
        --border: #e8e0d3;
        --shadow:
          0 1px 2px rgba(28, 26, 23, 0.04),
          0 8px 24px -12px rgba(28, 26, 23, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          "Cairo",
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
      }

      /* ---------- Header ---------- */
      .page-header {
        text-align: center;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
      }

      .page-header .kicker {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        background: rgba(138, 109, 59, 0.08);
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }

      .page-header h1 {
        font-family: "Amiri", serif;
        font-size: clamp(1.9rem, 4vw, 2.75rem);
        font-weight: 700;
        margin: 0 0 0.75rem;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .page-header p {
        color: var(--ink-soft);
        margin: 0 auto;
        max-width: 34rem;
        font-size: 1rem;
      }

      /* ---------- Stats ---------- */
      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 3rem;
      }

      .stat {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem 1rem;
        text-align: center;
        box-shadow: var(--shadow);
      }

      .stat .value {
        font-family: "Amiri", serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
        display: block;
        margin-bottom: 0.4rem;
      }

      .stat .label {
        font-size: 0.85rem;
        color: var(--ink-soft);
        font-weight: 600;
      }

      /* ---------- Book cards ---------- */
      .books {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .book {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
        transition: border-color 0.2s ease;
      }

      .book[open] {
        border-color: var(--accent-soft);
      }

      .book summary {
        list-style: none;
        cursor: pointer;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        user-select: none;
      }

      .book summary::-webkit-details-marker {
        display: none;
      }

      .book summary:hover .book-num {
        background: var(--accent);
        color: #fff;
      }

      .book-num {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: rgba(138, 109, 59, 0.1);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        transition:
          background 0.2s ease,
          color 0.2s ease;
      }

      .book-info {
        flex: 1;
        min-width: 0;
      }

      .book-title {
        font-family: "Amiri", serif;
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 0.35rem;
        color: var(--ink);
        line-height: 1.3;
      }

      .book-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        font-size: 0.82rem;
        color: var(--ink-soft);
      }

      .book-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      .book-meta .dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent-soft);
        display: inline-block;
      }

      .chevron {
        flex-shrink: 0;
        color: var(--ink-soft);
        transition: transform 0.25s ease;
      }

      .book[open] .chevron {
        transform: rotate(180deg);
        color: var(--accent);
      }

      /* ---------- Chapters ---------- */
      .chapters {
        list-style: none;
        margin: 0;
        padding: 0 1.5rem 1.25rem;
        border-top: 1px solid var(--border);
      }

      .chapter {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px dashed var(--border);
      }

      .chapter:last-child {
        border-bottom: none;
      }

      .chapter-num {
        flex-shrink: 0;
        font-family: "Cairo", sans-serif;
        font-weight: 700;
        font-size: 0.8rem;
        color: var(--accent);
        background: rgba(138, 109, 59, 0.08);
        border-radius: 6px;
        padding: 0.2rem 0.5rem;
        min-width: 2rem;
        text-align: center;
        margin-top: 0.15rem;
      }

      .chapter-info {
        flex: 1;
        min-width: 0;
      }

      .chapter-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 0.15rem;
        line-height: 1.5;
      }

      .chapter-meta {
        font-size: 0.78rem;
        color: var(--ink-soft);
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.85rem;
      }

      /* ---------- Footer ---------- */
      .page-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        text-align: center;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 640px) {
        .page {
          padding: 2rem 1rem 4rem;
        }

        .stats {
          grid-template-columns: 1fr;
          gap: 0.75rem;
        }

        .stat {
          display: flex;
          align-items: center;
          justify-content: space-between;
          text-align: right;
          padding: 0.85rem 1.1rem;
        }

        .stat .value {
          font-size: 1.4rem;
          margin: 0;
          order: 2;
        }

        .stat .label {
          order: 1;
        }

        .book summary {
          padding: 1rem 1rem;
          gap: 0.85rem;
        }

        .book-num {
          width: 2.25rem;
          height: 2.25rem;
          font-size: 0.9rem;
        }

        .book-title {
          font-size: 1.15rem;
        }

        .chapters {
          padding: 0 1rem 1rem;
        }
      }

      @media print {
        body {
          background: #fff;
        }
        .book {
          box-shadow: none;
          break-inside: avoid;
        }
        .book:not([open]) {
          /* ensure chapters show when printing */
        }
      }
    </style>
  </head>
  <body>
    <main class='page'>
      <header class='page-header'>
        <span class='kicker'>فهرس الدروس</span>
        <h1>كرسي الإمام مالك</h1>
        <p>
          فهرس الكتب والأبواب والأحاديث في سلسلة دروس موطأ الإمام مالك، مرتّبة
          حسب ترتيب الدروس.
        </p>
      </header>

      <section class='stats' aria-label='إحصاءات'>
        <div class='stat'>
          <span class='value'>{totalBooks}</span>
          <span class='label'>كتاب</span>
        </div>
        <div class='stat'>
          <span class='value'>{totalChapters}</span>
          <span class='label'>باب</span>
        </div>
        <div class='stat'>
          <span class='value'>{totalHadiths}</span>
          <span class='label'>حديث</span>
        </div>
      </section>

      <section class='books' aria-label='الكتب'>
        {books.map((book, index) => (
          <details class='book' open={index === 0}>
            <summary>
              <span class='book-num'>{book.book_number}</span>
              <div class='book-info'>
                <h2 class='book-title'>{book.title}</h2>
                <div class='book-meta'>
                  <span>{book.hadith_count} حديث</span>
                  <span class='dot' />
                  <span>{book.chapters.length} باب</span>
                  {book.start_episode != null && (
                    <>
                      <span class='dot' />
                      <span>
                        الدروس {book.start_episode}
                        {book.end_episode != null &&
                          book.end_episode !== book.start_episode &&
                          `–${book.end_episode}`}
                      </span>
                    </>
                  )}
                </div>
              </div>
              <svg
                class='chevron'
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <polyline points='6 9 12 15 18 9' />
              </svg>
            </summary>

            <ol class='chapters'>
              {book.chapters.map((chapter) => (
                <li class='chapter'>
                  <span class='chapter-num'>{chapter.chapter_number}</span>
                  <div class='chapter-info'>
                    <p class='chapter-title'>{chapter.title}</p>
                    <div class='chapter-meta'>
                      <span>{chapter.hadith_count} حديث</span>
                      {chapter.start_episode != null && (
                        <span>
                          الدرس {chapter.start_episode}
                          {chapter.end_episode != null &&
                            chapter.end_episode !== chapter.start_episode &&
                            `–${chapter.end_episode}`}
                        </span>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </section>

      <footer class='page-footer'>
        <p>كرسي الإمام مالك — فهرس الدروس</p>
      </footer>
    </main>
  </body>
</html>
