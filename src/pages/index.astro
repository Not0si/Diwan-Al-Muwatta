---
import BaseLayout from "../components/base-layout.astro"
import { getDiwanBooks } from "../generators/diwan-books"
import { getTimeline } from "../generators/timeline"

const timeline = await getTimeline()
const books = await getDiwanBooks(timeline)

const totalBooks = books.length
const totalChapters = books.reduce((sum, b) => sum + b.chapters.length, 0)
const totalHadiths = books.reduce((sum, b) => sum + b.hadith_count, 0)
const totalEpisodes = new Set(timeline.map((t) => t.episode)).size

const num = (n: number | null | undefined) =>
  n == null ? "" : n.toLocaleString("en-US", { useGrouping: false })

// Preview a handful of books on the home page
const featuredBooks = books.slice(0, 4)
---

<BaseLayout title='كرسي الإمام مالك — الصفحة الرئيسية'>
  <style>
    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 1.5rem 3rem;
      text-align: center;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: -20% -10% auto -10%;
      height: 60%;
      background: radial-gradient(
        ellipse at top,
        rgba(201, 169, 97, 0.18),
        transparent 60%
      );
      pointer-events: none;
      z-index: 0;
    }

    .hero > * {
      position: relative;
      z-index: 1;
    }

    .hero-kicker {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--accent);
      background: var(--accent-tint);
      padding: 0.4rem 1rem;
      border-radius: 999px;
      margin-bottom: 1.25rem;
    }

    .hero h1 {
      font-family: "Amiri", serif;
      font-size: clamp(2rem, 5.5vw, 3.25rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
      color: var(--ink);
    }

    .hero h1 em {
      font-style: normal;
      color: var(--accent);
    }

    .hero p {
      max-width: 40rem;
      margin: 0 auto 2rem;
      font-size: 1.05rem;
      color: var(--ink-soft);
      line-height: 1.9;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
    }

    .btn {
      font: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 0.8rem 1.5rem;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition:
        transform 0.15s ease,
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
      border: 1px solid transparent;
      cursor: pointer;
    }

    .btn:focus-visible {
      outline: 2px solid var(--accent-soft);
      outline-offset: 2px;
    }

    .btn-primary {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 8px 20px -10px rgba(138, 109, 59, 0.7);
    }

    .btn-primary:hover {
      background: #755c32;
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: var(--bg-card);
      border-color: var(--border);
      color: var(--ink);
    }

    .btn-ghost:hover {
      border-color: var(--accent-soft);
      color: var(--accent);
      transform: translateY(-1px);
    }

    /* ---------- Stats strip ---------- */
    .stats {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1rem;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .stat .value {
      font-family: "Amiri", serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent);
      line-height: 1;
      display: block;
      margin-bottom: 0.4rem;
      direction: ltr;
      unicode-bidi: isolate;
    }

    .stat .label {
      font-size: 0.85rem;
      color: var(--ink-soft);
      font-weight: 600;
    }

    /* ---------- Section ---------- */
    .section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section + .section {
      margin-top: 4rem;
    }

    .section-head {
      margin-bottom: 1.75rem;
    }

    .section-head h2 {
      font-family: "Amiri", serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      margin: 0 0 0.4rem;
      color: var(--ink);
    }

    .section-head p {
      margin: 0;
      color: var(--ink-soft);
      max-width: 42rem;
    }

    /* ---------- Feature cards ---------- */
    .features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .feature {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .feature:hover {
      transform: translateY(-3px);
      border-color: var(--accent-soft);
      box-shadow:
        0 2px 4px rgba(28, 26, 23, 0.04),
        0 24px 48px -24px rgba(28, 26, 23, 0.22);
    }

    .feature-icon {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 10px;
      background: var(--accent-tint);
      color: var(--accent);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .feature h3 {
      font-family: "Amiri", serif;
      font-size: 1.4rem;
      font-weight: 700;
      margin: 0;
      color: var(--ink);
    }

    .feature p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.95rem;
      line-height: 1.8;
      flex: 1;
    }

    .feature-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--accent);
      font-weight: 700;
      font-size: 0.9rem;
      margin-top: 0.25rem;
    }

    .feature-link svg {
      transition: transform 0.2s ease;
    }

    .feature:hover .feature-link svg {
      transform: translateX(-4px);
    }

    /* ---------- Books preview ---------- */
    .books-preview {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .book-preview {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 1rem 1.15rem;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      transition:
        border-color 0.15s ease,
        background 0.15s ease;
    }

    .book-preview:hover {
      border-color: var(--accent-soft);
      background: var(--accent-tint);
    }

    .book-preview-num {
      flex-shrink: 0;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background: var(--accent-tint);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      direction: ltr;
      unicode-bidi: isolate;
    }

    .book-preview-info {
      flex: 1;
      min-width: 0;
    }

    .book-preview-title {
      font-family: "Amiri", serif;
      font-size: 1.05rem;
      font-weight: 700;
      margin: 0 0 0.15rem;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .book-preview-meta {
      font-size: 0.78rem;
      color: var(--ink-soft);
    }

    .books-preview-more {
      grid-column: 1 / -1;
      text-align: center;
      margin-top: 0.5rem;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 780px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .features {
        grid-template-columns: 1fr;
      }

      .books-preview {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .hero {
        padding: 3rem 1rem 2rem;
      }

      .hero p {
        font-size: 1rem;
      }

      .stats {
        padding: 0 1rem 3rem;
        gap: 0.75rem;
      }

      .stat {
        padding: 0.85rem 1rem;
        text-align: right;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .stat .value {
        font-size: 1.4rem;
        margin: 0;
        order: 2;
      }

      .stat .label {
        order: 1;
      }

      .section {
        padding: 0 1rem;
      }
    }
  </style>

  <!-- ---------- Hero ---------- -->
  <section class='hero'>
    <span class='hero-kicker'>شرح موطأ الإمام مالك</span>
    <h1>
      كرسي <em>الإمام مالك</em>
    </h1>
    <p>
      سلسلة دروس علمية في شرح موطأ الإمام مالك رحمه الله، مرتّبة وموثّقة حسب
      الكتب والأبواب، مع فهرس شامل وجدول زمني يسهّل الوصول إلى كل درس.
    </p>

    <div class='hero-cta'>
      <a class='btn btn-primary' href='/diwan'>
        <svg
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'></path>
          <path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'></path>
        </svg>
        تصفّح الفهرس
      </a>
      <a class='btn btn-ghost' href='/timeline'>
        <svg
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <circle cx='12' cy='12' r='10'></circle>
          <polyline points='12 6 12 12 16 14'></polyline>
        </svg>
        الجدول الزمني
      </a>
    </div>
  </section>

  <!-- ---------- Stats ---------- -->
  <section class='stats' aria-label='إحصاءات السلسلة'>
    <div class='stat'>
      <span class='value'>{num(totalBooks)}</span>
      <span class='label'>كتاب</span>
    </div>
    <div class='stat'>
      <span class='value'>{num(totalChapters)}</span>
      <span class='label'>باب</span>
    </div>
    <div class='stat'>
      <span class='value'>{num(totalHadiths)}</span>
      <span class='label'>حديث</span>
    </div>
    <div class='stat'>
      <span class='value'>{num(totalEpisodes)}</span>
      <span class='label'>حلقة</span>
    </div>
  </section>

  <!-- ---------- Features ---------- -->
  <section class='section'>
    <div class='section-head'>
      <h2>ماذا تجد هنا؟</h2>
      <p>
        صُمّمت هذه المنصة لتسهيل الوصول إلى دروس كرسي الإمام مالك والتنقل بينها
        بسهولة.
      </p>
    </div>

    <div class='features'>
      <a class='feature' href='/diwan'>
        <span class='feature-icon' aria-hidden='true'>
          <svg
            width='22'
            height='22'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'></path>
            <path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'></path>
          </svg>
        </span>
        <h3>فهرس الكتب والأبواب</h3>
        <p>
          تصفّح جميع كتب الموطأ وأبوابها مرتّبة ترتيبًا منطقيًا، مع عدد الأحاديث
          في كل كتاب وباب، والوصول المباشر إلى الحلقة التي يبدأ فيها كل درس.
        </p>
        <span class='feature-link'>
          فتح الفهرس
          <svg
            width='14'
            height='14'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.4'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <line x1='19' y1='12' x2='5' y2='12'></line>
            <polyline points='12 19 5 12 12 5'></polyline>
          </svg>
        </span>
      </a>

      <a class='feature' href='/timeline'>
        <span class='feature-icon' aria-hidden='true'>
          <svg
            width='22'
            height='22'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <circle cx='12' cy='12' r='10'></circle>
            <polyline points='12 6 12 12 16 14'></polyline>
          </svg>
        </span>
        <h3>الجدول الزمني للدروس</h3>
        <p>
          عرض متسلسل لكل حلقة مع أوقاتها، يوضّح متى يبدأ كل كتاب وباب وحديث، مع
          روابط مباشرة للتشغيل عند كل نقطة زمنية.
        </p>
        <span class='feature-link'>
          عرض الجدول
          <svg
            width='14'
            height='14'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.4'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <line x1='19' y1='12' x2='5' y2='12'></line>
            <polyline points='12 19 5 12 12 5'></polyline>
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- ---------- Featured books ---------- -->
  <section class='section'>
    <div class='section-head'>
      <h2>نظرة على الكتب</h2>
      <p>بعض الكتب من الفهرس — اضغط للانتقال إلى الفهرس الكامل.</p>
    </div>

    <div class='books-preview'>
      {featuredBooks.map((book) => (
        <a class='book-preview' href={`/diwan#book-${book.book_number}`}>
          <span class='book-preview-num'>{num(book.book_number)}</span>
          <div class='book-preview-info'>
            <p class='book-preview-title'>{book.title}</p>
            <div class='book-preview-meta'>
              {num(book.hadith_count)} حديث · {num(book.chapters.length)} باب
            </div>
          </div>
        </a>
      ))}

      <div class='books-preview-more'>
        <a class='btn btn-ghost' href='/diwan'>
          عرض الفهرس الكامل ({num(totalBooks)} كتاب)
          <svg
            width='14'
            height='14'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.4'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <line x1='19' y1='12' x2='5' y2='12'></line>
            <polyline points='12 19 5 12 12 5'></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
