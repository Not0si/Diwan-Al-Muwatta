---
import { getTimeline } from "../generators/timeline"
import "../globals.css"

const timeline = await getTimeline()

// Group rows by episode for cleaner presentation
const episodes = timeline.reduce<{ episode: number; items: typeof timeline }[]>(
  (acc, item) => {
    const last = acc[acc.length - 1]
    if (last && last.episode === item.episode) {
      last.items.push(item)
    } else {
      acc.push({ episode: item.episode, items: [item] })
    }
    return acc
  },
  []
)

// Arabic-Indic digits helper
const ar = (n: number | null | undefined) =>
  n == null ? "" : n.toLocaleString("ar-EG", { useGrouping: false })

const formatTime = (seconds: number) => {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  const s = seconds % 60
  const pad = (n: number) => String(n).padStart(2, "0")
  return h > 0 ? `${ar(h)}:${pad(m)}:${pad(s)}` : `${ar(m)}:${pad(s)}`
}

const prefixLabel: Record<string, { label: string; cls: string }> = {
  Book: { label: "كتاب", cls: "tag-book" },
  Chapter: { label: "باب", cls: "tag-chapter" },
  Hadith: { label: "حديث", cls: "tag-hadith" },
  None: { label: "", cls: "tag-none" },
}
---

<html lang='ar' dir='rtl'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>الجدول الزمني — كرسي الإمام مالك</title>
    <meta
      name='description'
      content='الجدول الزمني لدروس كرسي الإمام مالك، مرتّب حسب الحلقات والأوقات.'
    />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Amiri:wght@700&family=JetBrains+Mono:wght@400;500&display=swap'
      rel='stylesheet'
    />
    <style>
      :root {
        --bg: #faf7f2;
        --bg-card: #ffffff;
        --bg-row: #fdfcfa;
        --ink: #1c1a17;
        --ink-soft: #5b554c;
        --ink-faint: #9a9288;
        --accent: #8a6d3b;
        --accent-soft: #c9a961;
        --border: #e8e0d3;
        --border-soft: #f0eadf;
        --shadow:
          0 1px 2px rgba(28, 26, 23, 0.04),
          0 8px 24px -12px rgba(28, 26, 23, 0.12);
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          "Cairo",
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 880px;
        margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
      }

      /* ---------- Header ---------- */
      .page-header {
        text-align: center;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
      }

      .page-header .kicker {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
        background: rgba(138, 109, 59, 0.08);
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }

      .page-header h1 {
        font-family: "Amiri", serif;
        font-size: clamp(1.9rem, 4vw, 2.75rem);
        font-weight: 700;
        margin: 0 0 0.75rem;
        color: var(--ink);
      }

      .page-header p {
        color: var(--ink-soft);
        margin: 0 auto;
        max-width: 34rem;
        font-size: 1rem;
      }

      /* ---------- Episode ---------- */
      .episode {
        margin-bottom: 2.5rem;
      }

      .episode-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--accent-soft);
      }

      .episode-badge {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 700;
        font-size: 0.85rem;
        color: #fff;
        background: var(--accent);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        letter-spacing: 0.02em;
      }

      .episode-badge .icon {
        opacity: 0.85;
      }

      .episode-title {
        font-family: "Amiri", serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
        flex: 1;
        min-width: 0;
      }

      .episode-count {
        font-size: 0.8rem;
        color: var(--ink-soft);
        font-weight: 600;
        white-space: nowrap;
      }

      /* ---------- Timeline rows ---------- */
      .rows {
        list-style: none;
        margin: 0;
        padding: 0;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .row {
        display: grid;
        grid-template-columns: 6.5rem 1fr auto;
        gap: 1rem;
        align-items: center;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--border-soft);
        transition: background 0.15s ease;
      }

      .row:last-child {
        border-bottom: none;
      }

      .row:hover {
        background: var(--bg-row);
      }

      .row.is-book,
      .row.is-chapter {
        background: linear-gradient(
          to left,
          rgba(201, 169, 97, 0.06),
          transparent 60%
        );
      }

      .row.is-book {
        border-top: 1px solid var(--border);
      }

      /* time column */
      .time {
        font-family: var(--mono);
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--accent);
        background: rgba(138, 109, 59, 0.08);
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        text-align: center;
        direction: ltr;
        white-space: nowrap;
      }

      /* detail column */
      .detail {
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .detail-text {
        font-size: 1rem;
        color: var(--ink);
        line-height: 1.5;
        word-break: break-word;
      }

      .row.is-book .detail-text {
        font-family: "Amiri", serif;
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--accent);
      }

      .row.is-chapter .detail-text {
        font-weight: 700;
        font-size: 1.05rem;
      }

      /* prefix tag */
      .tag {
        flex-shrink: 0;
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      .tag-book {
        background: rgba(138, 109, 59, 0.15);
        color: var(--accent);
      }

      .tag-chapter {
        background: rgba(201, 169, 97, 0.18);
        color: #8a6d3b;
      }

      .tag-hadith {
        background: rgba(28, 26, 23, 0.06);
        color: var(--ink-soft);
      }

      .tag-none {
        display: none;
      }

      /* duration column */
      .duration {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--ink-faint);
        direction: ltr;
        white-space: nowrap;
      }

      /* ---------- Footer ---------- */
      .page-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        text-align: center;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      /* ---------- Empty state ---------- */
      .empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--ink-soft);
        background: var(--bg-card);
        border: 1px dashed var(--border);
        border-radius: 14px;
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 640px) {
        .page {
          padding: 2rem 1rem 4rem;
        }

        .row {
          grid-template-columns: 5rem 1fr;
          grid-template-areas:
            "time detail"
            ".    duration";
          gap: 0.35rem 0.75rem;
          padding: 0.75rem 1rem;
        }

        .time {
          grid-area: time;
          align-self: start;
          font-size: 0.75rem;
        }

        .detail {
          grid-area: detail;
        }

        .duration {
          grid-area: duration;
          justify-self: start;
        }

        .episode-header {
          flex-wrap: wrap;
        }

        .episode-title {
          font-size: 1.1rem;
        }

        .episode-count {
          width: 100%;
        }
      }

      @media print {
        body {
          background: #fff;
        }
        .rows {
          box-shadow: none;
          break-inside: avoid;
        }
        .row:hover {
          background: transparent;
        }
      }
    </style>
  </head>
  <body>
    <main class='page'>
      <header class='page-header'>
        <span class='kicker'>الجدول الزمني</span>
        <h1>كرسي الإمام مالك</h1>
        <p>
          الجدول الزمني الكامل لدروس السلسلة، مرتّبًا حسب الحلقات مع الإشارة إلى
          الكتاب والباب الذي يندرج تحته كل درس.
        </p>
      </header>

      {episodes.length === 0 ? (
        <div class='empty'>لا توجد بيانات لعرضها.</div>
      ) : (
        episodes.map(({ episode, items }) => (
          <section class='episode' aria-label={`الحلقة ${episode}`}>
            <div class='episode-header'>
              <span class='episode-badge'>
                <svg
                  class='icon'
                  width='14'
                  height='14'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2.5'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  aria-hidden='true'
                >
                  <polygon points='5 3 19 12 5 21 5 3' />
                </svg>
                الحلقة {ar(episode)}
              </span>
              <h2 class='episode-title'>
                {items.find((i) => i.book)?.book || "—"}
              </h2>
              <span class='episode-count'>{ar(items.length)} سطر</span>
            </div>

            <ol class='rows'>
              {items.map((item) => {
                const prefix = prefixLabel[item.prefix] ?? prefixLabel.None
                return (
                  <li
                    class:list={[
                      "row",
                      item.prefix === "Book" && "is-book",
                      item.prefix === "Chapter" && "is-chapter",
                    ]}
                  >
                    <span class='time'>{item.timeString}</span>
                    <div class='detail'>
                      {prefix.label && (
                        <span class:list={["tag", prefix.cls]}>
                          {prefix.label}
                        </span>
                      )}
                      <span class='detail-text'>{item.detail}</span>
                    </div>
                    <span class='duration'>
                      {item.duration != null
                        ? `+${formatTime(item.duration)}`
                        : ""}
                    </span>
                  </li>
                )
              })}
            </ol>
          </section>
        ))
      )}

      <footer class='page-footer'>
        <p>كرسي الإمام مالك — الجدول الزمني</p>
      </footer>
    </main>
  </body>
</html>
